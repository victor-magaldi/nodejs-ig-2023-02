{
  "name": "nodejs-ig-2023-02",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "npx tsx watch src/server.ts",
    "lint": "eslint src --ext .ts --fix",
    "migration:create": "NODE_OPTIONS='--import tsx' npx knex migrate:make $npm_config_name -x ts",
    "migrate:latest": "NODE_OPTIONS='--import tsx' npx knex -- migrate:latest",
    "migrate:rollback": "NODE_OPTIONS='--import tsx' npx knex -- migrate:rollback",
    "test": "vitest",
    "build":"tsup src --out-dir build",
    "start": "node build/server.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/victor-magaldi/nodejs-ig-2023-02.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/victor-magaldi/nodejs-ig-2023-02/issues"
  },
  "homepage": "https://github.com/victor-magaldi/nodejs-ig-2023-02#readme",
  "devDependencies": {
    "@rocketseat/eslint-config": "^2.2.2",
    "@types/supertest": "^6.0.3",
    "eslint": "^8.57.1",
    "supertest": "^7.1.4",
    "tsup": "^8.5.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.2",
    "knex": "^3.1.0",
    "sqlite3": "^5.1.7",
    "zod": "^4.3.4"
  }
}
